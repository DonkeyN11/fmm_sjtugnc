<?xml version="1.0" encoding="UTF-8"?>
<config>
  <input>
    <network><file>input/map/hainan/edges.shp</file><id>key</id><source>u</source><target>v</target></network>
    <ubodt><file>input/map/hainan_ubodt_indexed.bin</file></ubodt>
    <gps>
      <file>data/real_vehicle/hainan_06/cmm_input_points.csv</file>
      <id>id</id><x>x</x><y>y</y><timestamp>timestamp</timestamp>
      <sde>sde</sde><sdn>sdn</sdn><sdu>sdu</sdu>
      <sdne>sdne</sdne><sdeu>sdeu</sdeu><sdun>sdun</sdun>
      <protection_level>protection_level</protection_level>
    </gps>
    <gps_point>true</gps_point>
  </input>
  <output>
    <file>data/real_vehicle/hainan_06/processed/cmm_result_0729.csv</file>
    <point_mode>true</point_mode>
    <fields><seq/><timestamp/><ogeom/><cpath/><tpath/><opath/><pgeom/>
      <ep/><tp/><trustworthiness/><n_best_trustworthiness/><candidates/>
      <status/><delta_entropy/><posterior_entropy/><h0_lambda/><cumu_prob/></fields>
  </output>
  <parameters>
    <k>16</k>
    <min_candidates>1</min_candidates>
    <protection_level_multiplier>3</protection_level_multiplier>
    <reverse_tolerance>0.1</reverse_tolerance>
    <normalized>true</normalized>
    <use_mahalanobis>true</use_mahalanobis>
    <filtered>true</filtered>
    <window_length>100</window_length>
    <max_interval>180.0</max_interval>
    <trustworthiness_threshold>0.0</trustworthiness_threshold>
    <phmi>0.00001</phmi>
    <lag_steps>0</lag_steps>
    <phmi_pl_multiplier>1</phmi_pl_multiplier>
    <h0_prior_log_odds>0</h0_prior_log_odds>
    <background_prob>0.1</background_prob>
    <map_error_std>5.0e-6</map_error_std>
    <min_gps_error_degrees>1.0e-6</min_gps_error_degrees>
    <cumulative_reverse_pct>0.03</cumulative_reverse_pct>
  </parameters>
  <other>
    <log_level>2</log_level>
    <use_omp>true</use_omp>
    <step>500</step>
    <input_epsg>4326</input_epsg>
  </other>
</config>
