install_manifest.txt
compile_commands.json
CTestTestfile.cmake
_deps/

# ── Data files (too large for GitHub) ──
data/
dataset-hainan/
dataset-hainan-06/
input/map/
input/trajectory/
*.csv
!experiments/config/*.json
!experiments/config/reverse_edge_map.json

# ── Experiment outputs ──
experiments/output/

# ── Archived / review ──
_archive_review/

# ── IDE / Editor ──
.claude/
.gemini/
.vscode/
.idea/
.playwright/
.playwright-cli/
.kdev4/

# ── OS files ──
**/.DS_Store
Thumbs.db

# ── LaTeX auxiliary ──
*.aux
*.synctex.gz
*.fls
*.blg
*.out
*.toc
*.fdb_latexmk
*.bcf
*.run.xml
*.bbl
*.log

# ── Build outputs ──
*.o
*.ko
*.obj
*.elf
*.gch
*.pch
*.lib
*.a
*.la
*.lo
*.dll
*.so
*.so.*
*.dylib
*.exe
*.app
*.i*86
*.x86_64
*.hex
*.dSYM/
*.su
*.d

# ── Python cache ──
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# ── IDE project files ──
*.cbp
*.depend
*.layout
*.kdev4

# ── Documentation and results (not needed for build) ──
docs/
data/
experiments/output/
experiments/math_theory.md

# ── Misc ──
sync.sh
*.tmp
tmp/
